# Shared jev-loop MCP server over streamable HTTP, for every harness on the tailnet.
#
# Install (as root) on the always-on host:
#   cp deploy/jev-loop-http.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now jev-loop-http
#   curl -s -o /dev/null -w '%{http_code}\n' http://<tailnet-ip>:8765/mcp   # 405/406 = alive
#
# Adjust User, WorkingDirectory and --host. Bind to the host's tailnet address only:
# the server has no authentication of its own and holds the TypeSafe key.
[Unit]
Description=jev-loop MCP server (Jev Loop and Gate) over HTTP for the tailnet
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=ai-agents
WorkingDirectory=/home/hermes/jev-loop
ExecStart=/home/hermes/jev-loop/.venv/bin/python /home/hermes/jev-loop/jev_mcp.py --http --host 100.71.244.124 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
